# Copy this file to backend/.env and adjust if needed. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml
DATABASE_URL=mysql://marinus:marinus@127.0.0.1:3306/marinus

# The Vite dev server origin (needed for CSRF checks during local development)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local only: emails print to the terminal instead of being sent
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

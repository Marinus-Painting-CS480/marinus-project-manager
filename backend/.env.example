# Copy this file to backend/.env and adjust if needed. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml
DATABASE_URL=mysql://marinus:marinus@127.0.0.1:3306/marinus

# The Vite dev server origin (needed for CSRF checks during local development)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local only: emails print to the terminal instead of being sent
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Links sent to customers are built from this (production: https://app.marinus.llc)
SITE_URL=http://localhost:5173
PROPOSAL_LINK_DAYS=30
DEFAULT_LABOR_ALLOCATION_PERCENT=30

# Photo limits
PHOTO_MAX_MB=15
PHOTO_MAX_FILES_PER_UPLOAD=20

# ---- Production only (see docs/DEPLOYMENT.md) ----
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<long random value>
# DJANGO_ALLOWED_HOSTS=app.marinus.llc
# CSRF_TRUSTED_ORIGINS=https://app.marinus.llc
# MEDIA_ROOT=/home/<cpanel-user>/marinus-media   (outside public_html)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.marinus.llc
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@marinus.llc
# EMAIL_HOST_PASSWORD=<password>
# DEFAULT_FROM_EMAIL=Marinus Painting <no-reply@marinus.llc>
